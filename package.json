{
  "name": "gestion-casos",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.5.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-auth-session": "~57.0.11",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npx expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/features/auth/authService.ts",
      "src/features/auth/authErrors.ts",
      "src/features/auth/permissions.ts",
      "src/features/auth/schemas.ts",
      "src/components/forms/FormField.tsx",
      "src/services/supabase/secureStorage.ts",
      "src/store/authStore.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
